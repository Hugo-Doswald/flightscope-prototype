{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlightScope",
  "version": "0.2.0",
  "identifier": "app.caf4u.flightscope",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlightScope",
        "width": 430,
        "height": 860,
        "minWidth": 320,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 24
    },
    "icon": []
  }
}
